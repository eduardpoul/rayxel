<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Rayxel.Send.App"
        x:Class="Rayxel.Send.App.MainWindow"
        x:DataType="app:MainViewModel"
        Title="{app:T title}"
        Icon="avares://rayxel-send-ui/Assets/rayxel.ico"
        Width="420" Height="620" MinWidth="340" MinHeight="400"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding ConfirmNoCommand}" />
  </Window.KeyBindings>

  <Grid>

    <!-- Nothing answers on the socket: say so, and offer to start the sender. -->
    <StackPanel IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" Margin="32" Spacing="14">
      <TextBlock Text="{app:T notRunning}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{app:T notRunningBody}" Classes="dim" TextWrapping="Wrap" />
      <Button Classes="accent" Content="{app:T start}" Command="{Binding StartSenderCommand}"
              IsEnabled="{Binding !IsStarting}" MinWidth="120" HorizontalContentAlignment="Center" />
      <TextBlock Text="{Binding StartNote}" IsVisible="{Binding StartNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />
      <TextBlock Text="{app:T retrying}" Classes="hint" />
    </StackPanel>

    <ScrollViewer x:Name="Scroller" IsVisible="{Binding IsConnected}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" Spacing="12">

        <!-- Who this is. -->
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding SenderName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding SenderAbout}" Classes="hint" />
        </StackPanel>

        <Border IsVisible="{Binding HasNotice}" Background="{StaticResource NoticeBrush}" CornerRadius="6" Padding="12,8">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>

        <!-- Where it stands, and the two things most often done to it. -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StateWord}" Foreground="{Binding StateBrush}"
                         FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SwitchedOn}"
                            OnContent="{app:T on}" OffContent="{app:T off}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding StateDetail}" Classes="dim" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Classes="warn" />
            <Button Content="{Binding DiscoverText}" Command="{Binding ToggleDiscoverableCommand}"
                    IsEnabled="{Binding CanDiscover}" ToolTip.Tip="{Binding DiscoverTip}" ToolTip.ShowOnDisabled="True"
                    Classes.accent="{Binding !IsDiscoverable}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- A computer is pairing: the PIN to type into it, as large as the window allows. -->
        <Border Classes="card pairing" IsVisible="{Binding IsPairing}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PairingTitle}" Classes="title" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding HasPin}" Spacing="4">
              <TextBlock Text="{app:T pairTypePin}" Classes="dim" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PinText}" FontSize="64" FontWeight="Bold" LetterSpacing="4"
                         HorizontalAlignment="Center" Margin="0,4" />
            </StackPanel>
            <TextBlock Text="{app:T pairExchanging}" IsVisible="{Binding !HasPin}" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,12" Classes="dim" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding PairingLeft}" Classes="dim" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{app:T cancel}" Command="{Binding CancelPairingCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- The computers that may connect. -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{app:T pairedTitle}" Classes="title" />
            <TextBlock Text="{app:T pairedNone}" Classes="dim" IsVisible="{Binding !HasViewers}" />
            <ItemsControl ItemsSource="{Binding Viewers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:PairedViewerItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Seen}" Classes="hint" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{app:T forget}" Command="{Binding ForgetCommand}"
                            VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- What this machine can send, and why not when it cannot. -->
        <Border Classes="card" IsVisible="{Binding HasCodecs}">
          <StackPanel Spacing="6">
            <TextBlock Text="{app:T codecsTitle}" Classes="title" />
            <ItemsControl ItemsSource="{Binding Codecs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:CodecItem">
                  <Grid ColumnDefinitions="90,*" Margin="0,2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="dim" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Expander Header="{app:T settings}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  IsEnabled="{Binding Settings.IsLoaded}">
          <StackPanel Spacing="14">

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sName}" />
              <TextBox Text="{Binding Settings.Name}" PlaceholderText="{app:T sNameEmpty}" />
              <TextBlock Text="{app:T sNameHint}" Classes="hint" />
            </StackPanel>

            <StackPanel Spacing="2">
              <CheckBox Content="{app:T sAllowInput}" IsChecked="{Binding Settings.AllowInput}" />
              <TextBlock Text="{app:T sAllowInputHint}" Classes="hint" Margin="28,0,0,0" />
            </StackPanel>

            <CheckBox Content="{app:T sStartEnabled}" IsChecked="{Binding Settings.StartEnabled}" />

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sDiscoverableMinutes}" />
              <NumericUpDown Value="{Binding Settings.DiscoverableMinutes}" Minimum="1" Maximum="120" Increment="1"
                             FormatString="0" HorizontalAlignment="Left" MinWidth="140" />
            </StackPanel>

            <StackPanel Spacing="2">
              <CheckBox Content="{app:T sAllowUnpaired}" IsChecked="{Binding Settings.AllowUnpaired}" />
              <TextBlock Text="{app:T sAllowUnpairedHint}" Classes="hint" Margin="28,0,0,0" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sSource}" />
              <TextBox Text="{Binding Settings.Source}" PlaceholderText="{app:T sSourcePlaceholder}" />
              <TextBlock Text="{app:T sSourceHint}" Classes="hint" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sPort}" />
              <NumericUpDown Value="{Binding Settings.Port}" Minimum="1024" Maximum="65535" Increment="1"
                             FormatString="0" HorizontalAlignment="Left" MinWidth="140" />
              <TextBlock Text="{app:T sPortHint}" Classes="hint" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sBuffer}" />
              <NumericUpDown Value="{Binding Settings.BufferFrames}" Minimum="0.25" Maximum="30" Increment="0.25"
                             FormatString="0.##" HorizontalAlignment="Left" MinWidth="140" />
              <TextBlock Text="{app:T sBufferHint}" Classes="hint" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sMaxFrame}" />
              <NumericUpDown Value="{Binding Settings.MaxFrame}" Minimum="0" Maximum="50" Increment="0.5"
                             FormatString="0.##" HorizontalAlignment="Left" MinWidth="140" />
              <TextBlock Text="{app:T sMaxFrameHint}" Classes="hint" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{app:T sGop}" />
              <NumericUpDown Value="{Binding Settings.Gop}" Minimum="0" Maximum="100000" Increment="30"
                             FormatString="0" HorizontalAlignment="Left" MinWidth="140" />
              <TextBlock Text="{app:T sGopHint}" Classes="hint" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="accent" Content="{app:T save}" Command="{Binding SaveCommand}"
                      IsEnabled="{Binding Settings.IsDirty}" MinWidth="100" HorizontalContentAlignment="Center" />
              <TextBlock Text="{Binding SaveNote}" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- Ending the sender is kept apart from switching it off, and below everything else. -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <Button Content="{app:T quitSender}" Command="{Binding QuitSenderCommand}" />
          <TextBlock Text="{app:T quitHint}" Classes="hint" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- The question before forgetting a computer or quitting. -->
    <Border IsVisible="{Binding ConfirmVisible}" Background="{StaticResource ScrimBrush}">
      <Border Classes="card" VerticalAlignment="Center" Margin="24" MaxWidth="380">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ConfirmTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfirmBody}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="{Binding ConfirmOk}" Command="{Binding ConfirmYesCommand}"
                    Classes.danger="{Binding ConfirmIsDanger}" />
            <Button Content="{app:T cancel}" Command="{Binding ConfirmNoCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
